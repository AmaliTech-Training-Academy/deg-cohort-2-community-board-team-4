# ==============================================================================
# Environment Configuration Template (.env.example)
#
# Copy this template to '.env' in the root directory to define local container variables.
# ==============================================================================

# --- FRONTEND (Angular Container) ---
# Port exposed on the host to serve the static frontend bundle (e.g., http://localhost:3000)
FRONTEND_PORT=3000

# Backend API URL targeted by the Angular client over the public network
FRONTEND_API_URL=http://localhost:8080/api

# --- BACKEND (Java Spring Boot Container) ---
# Port mapping for the REST API
BACKEND_PORT=8080

# Base context path prefix for REST endpoints
BACKEND_CONTEXT_PATH=/api

# HS256 secret key for signing JWT tokens (use a unique, secure 32-character key locally)
JWT_SECRET=placeholder_32_character_hex_secret_key_for_jwt

# --- DATABASE (PostgreSQL Container) ---
# The hostname of the db container defined in docker-compose.yml
DB_HOST=postgres

# The host port mapped to PostgreSQL
DB_PORT=5432

# PostgreSQL default parameters
DB_NAME=communityboard
DB_USER=postgres
DB_PASSWORD=placeholder_secure_database_password_123
