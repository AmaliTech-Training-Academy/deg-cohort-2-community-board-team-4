# ==============================================================================
# Environment Configuration Template (.env.example)
#
# Copy this template to '.env' in the root directory to define local container variables.
# ==============================================================================

# --- FRONTEND (Angular Container) ---
# Port exposed on the host to serve the static frontend bundle (e.g., 3000)
FRONTEND_PORT=

# Backend API URL targeted by the Angular client over the public network (e.g., http://localhost:8080/api)
FRONTEND_API_URL=

# --- BACKEND (Java Spring Boot Container) ---
# Port mapping for the REST API (e.g., 8080)
BACKEND_PORT=

# Base context path prefix for REST endpoints (e.g., /api)
BACKEND_CONTEXT_PATH=

# HS256 secret key for signing JWT tokens (must be at least 32 characters)
JWT_SECRET=

# --- DATABASE (PostgreSQL Container) ---
# The hostname of the db container defined in docker-compose.yml (e.g., postgres)
DB_HOST=

# The host port mapped to PostgreSQL (e.g., 5432)
DB_PORT=

# PostgreSQL default parameters
DB_NAME=
DB_USER=
DB_PASSWORD=
