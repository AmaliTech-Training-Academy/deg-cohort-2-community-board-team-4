# Deployment environment: local | development | staging | production
# Guards destructive/dev-only scripts (seed.py, init_db.py) against prod.
# Defaults to "local" if unset.
APP_ENV=local

# Analytics output directory (optional). Where analytics.py writes its JSON
# datasets. Defaults to <package>/output if unset; set to a mounted volume in
# containers.
# ANALYTICS_OUTPUT_DIR=/data/analytics

# Database Configuration
# NOTE: These are dummy/example values. Update with your actual database credentials.
DB_HOST=your_database_host_here
DB_PORT=5432
DB_NAME=your_database_name_here
DB_USER=your_database_user_here
DB_PASSWORD=your_secure_password_here
