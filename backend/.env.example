# Active Spring profile (dev | prod ...)
SPRING_PROFILES_ACTIVE=dev

# Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/communityboard_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT signing secret (use a long, random value in real environments)
JWT_SECRET=communityboard-secret-key-amalitech-2024

# Cloudinary (image uploads) — get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional overrides
CLOUDINARY_UPLOAD_FOLDER=community-board/posts
CLOUDINARY_PLACEHOLDER_URL=https://res.cloudinary.com/demo/image/upload/v1/community-board/placeholder.png
